<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Knightfall.ScaleSet.Aws.Core/Knightfall.ScaleSet.Aws.Core.csproj" />
    <ProjectReference Include="../../src/Knightfall.ScaleSet.Aws.Controller/Knightfall.ScaleSet.Aws.Controller.csproj" />
    <ProjectReference Include="../../src/Knightfall.ScaleSet.Aws.Handoff/Knightfall.ScaleSet.Aws.Handoff.csproj" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../testdata/config/runtime/*.json" Link="ConfigFixtures/runtime/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/config/rejections.json" Link="ConfigFixtures/rejections.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/dryrun/replay.json" Link="Fixtures/DryRun/replay.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../cdk/config/schema/*.json" Link="ConfigFixtures/schema/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
