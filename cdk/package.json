{
  "name": "scaleset-dotnet-aws-cdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.1"
    }
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
