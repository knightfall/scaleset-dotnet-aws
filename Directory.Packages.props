<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="[5.0.1]" PrivateAssets="all" IncludeAssets="analyzers" />
    <PackageVersion Include="xunit.v3" Version="[4.0.3]" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="JsonSchema.Net" Version="[9.7.0]" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Knightfall.ScaleSet.Client" Version="[0.1.0-alpha.1]" />
    <PackageVersion Include="Knightfall.ScaleSet.Listener" Version="[0.1.0-alpha.1]" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="AWSSDK.Core" Version="[4.1.1.2]" />
    <PackageVersion Include="AWSSDK.CloudWatchLogs" Version="[4.1.0.2]" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="[4.1.0.3]" />
    <PackageVersion Include="AWSSDK.EC2" Version="[4.1.5]" />
    <PackageVersion Include="AWSSDK.ECS" Version="[4.1.1.1]" />
    <PackageVersion Include="AWSSDK.IdentityManagement" Version="[4.1.3]" />
    <PackageVersion Include="AWSSDK.S3" Version="[4.1.2]" />
    <PackageVersion Include="AWSSDK.SecretsManager" Version="[4.1.1.2]" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="[4.1.1.1]" />
    <PackageVersion Include="AWSSDK.SQS" Version="[4.1.0.2]" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="[10.0.12]" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="[11.0.0]" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="[1.21.0]" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="[1.21.0]" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="[1.21.0]" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="[1.21.0]" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="[11.0.0]" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="[6.1.1]" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="[4.2.0]" />
  </ItemGroup>
</Project>
