    <ContainerImageFormat>OCI</ContainerImageFormat>
    <ContainerRepository>scaleset-aws-controller</ContainerRepository>
    <ContainerUser>1654</ContainerUser>
    <ContainerAppCommandInstruction>Entrypoint</ContainerAppCommandInstruction>
